# Operator config for docker-compose.yml. Copy to `.env`, fill in, then
# `docker compose up -d`. See docs/ops/deploy.md.

# The image tag to run, e.g. a release like `0.3.0` — never `latest`,
# so an upgrade is a deliberate `docker compose pull` to a version you
# chose, not whatever GHCR happens to have built most recently.
STUDIO_VERSION=

# The domain Caddy requests a certificate for and the studio is served
# from, e.g. studio.example.com. Only used when running the default
# Caddy profile; ignored if you're using the nginx or Cloudflare Tunnel
# alternative instead.
DOMAIN=

# Passed straight through to the `studio` container; see
# docs/server-env.md for what each one does. PUBLIC_URL should be
# `https://` + the DOMAIN above — set as its own value, not a reference,
# since .env files aren't variable-expanded.
PUBLIC_URL=
LOG_LEVEL=info
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=
SECRET_KEY=
BACKENDS_ENABLED=true
MIN_FREE_DISK_GB=10
MAX_UPLOAD_MB=500
FFMPEG_CONCURRENCY=2

# Optional; commented out rather than blank, since the server treats an
# empty string differently from unset. Uncomment and set a bearer token
# to let your outside monitor call GET /api/status without an Admin
# session (docs/server-env.md#status_token).
# STATUS_TOKEN=

# Optional; uncomment and set both to sign every Asset's C2PA manifest
# with your own certificate (docs/server-env.md#c2pa_cert_path). Paths
# are read inside the container, so mount the files there too (e.g. a
# `./certs:/certs:ro` volume on the `studio` service) and point these at
# the mounted path. C2PA_TIMESTAMP_URL is optional on top of these two.
# C2PA_CERT_PATH=
# C2PA_KEY_PATH=
# C2PA_TIMESTAMP_URL=

# Postgres credentials, shared between the `postgres` and `studio`
# services. Change the password before your first `docker compose up`;
# Postgres only applies it when initializing an empty data volume.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_content_studio

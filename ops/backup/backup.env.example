# Operator config for backup.sh and restore.sh. Copy to `backup.env`,
# next to docker-compose.yml and .env (not left in ops/backup/), and
# fill in. See docs/ops/backup.md.

# Where restic keeps snapshots: any backend restic supports (s3:...,
# sftp:..., b2:..., rest:...) — the real point of a backup, so it
# survives this host dying. For a local disk instead (only sensible if
# that disk is itself synced off-host some other way, e.g. a mounted
# network drive), use exactly `/restic-repo`: docker-compose.yml mounts
# `./restic-repo` (next to this file) at that path in the backup/restore
# containers.
RESTIC_REPOSITORY=

# The repository's encryption password. Generate one with
# `openssl rand -base64 32` and keep it somewhere other than this host —
# losing it loses every snapshot, encrypted and unrecoverable by design.
RESTIC_PASSWORD=

# Optional: a healthchecks.io-style ping URL. backup.sh calls it bare on
# success and with "/fail" appended on failure (aborted pg_dump, a failed
# restic command). Leave blank to skip pinging.
# BACKUP_PING_URL=

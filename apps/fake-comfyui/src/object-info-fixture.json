  "KSampler": {
    "input": {
      "required": {
        "model": ["MODEL"],
        "seed": [
          "INT",
          { "default": 0, "min": 0, "max": 18446744073709552000 }
        ],
        "steps": ["INT", { "default": 20, "min": 1, "max": 10000 }],
        "cfg": ["FLOAT", { "default": 8.0, "min": 0.0, "max": 100.0 }],

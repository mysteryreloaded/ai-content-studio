# Copy this file to /etc/comfyui/<gpu-index>.env on the Backend host, one file
# per GPU, and edit the values for that machine. The filename's <gpu-index>
# must match the systemd instance name, e.g. /etc/comfyui/0.env for
# `comfyui@0.service`, /etc/comfyui/1.env for `comfyui@1.service`.
#
# See docs/ops/backend-kit.md for the full setup.

# This host's private Tailscale IP (`tailscale ip -4`). Every ComfyUI
# instance on the host listens on the same IP, each on its own port — never
# listen on 0.0.0.0 or a public IP.
BACKEND_IP=100.64.0.5

# 8188 for GPU 0, 8189 for GPU 1, and so on.
BACKEND_PORT=8188

# Must be >= the studio's configured max upload size (Site settings), so
# large reference Uploads aren't rejected by ComfyUI before the studio ever
# sees them.
MAX_UPLOAD_MB=512
